VITE_USE_MOCK_API=true
VITE_API_BASE_URL=http://localhost:8787
VITE_TAROT_ASSET_BASE_URL=

NODE_ENV=development
PORT=8787
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://pet10:pet10@localhost:5432/pet10
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_LOGIN_RATE_LIMIT_PER_MINUTE=10
# 仅用于约束历史邮箱令牌，邮箱验证码登录已移除
ALLOWED_EMAILS=

# OpenAI-compatible provider
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Tavily Web Search
# Only SEARCH_API_KEY is required. Get a key from https://app.tavily.com/
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.tavily.com
SEARCH_TIMEOUT_MS=8000
SEARCH_MAX_QUERIES=2
SEARCH_MAX_RESULTS=8
SEARCH_MAX_SNIPPET_LENGTH=700
SEARCH_LOCALE=zh-cn

OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=

IMAGE_INVITE_CODE=change-me
IMAGE_UPSTREAM_BASE_URL=https://apirouter.zhiqiteai.cn/ApiRouterServ/v1
IMAGE_UPSTREAM_API_KEY=
IMAGE_RATE_LIMIT_PER_MINUTE=3
IMAGE_DAILY_LIMIT=30
IMAGE_MAX_PROMPT_LENGTH=4000
