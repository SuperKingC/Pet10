POSTGRES_PASSWORD=replace-with-a-strong-database-password
APP_ORIGIN=https://43-156-174-77.sslip.io
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d
WECHAT_LOGIN_RATE_LIMIT_PER_MINUTE=10
# 仅用于约束历史邮箱令牌，邮箱验证码登录已移除
ALLOWED_EMAILS=first@example.com,second@example.com
STATIC_ASSET_BASE_URL=https://your-bucket.cos.ap-guangzhou.myqcloud.com/pet10-web
STATIC_ASSET_VERSION=replace-with-deployed-full-git-sha

# OpenAI-compatible provider
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Tavily Web Search
# Only SEARCH_API_KEY is required. Keep the real key in the server's .env.production.
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.tavily.com
SEARCH_TIMEOUT_MS=8000
SEARCH_MAX_QUERIES=2
SEARCH_MAX_RESULTS=8
SEARCH_MAX_SNIPPET_LENGTH=700
SEARCH_LOCALE=zh-cn

# 小多利主动行为 sweep 间隔（毫秒），0=关闭；默认 10 分钟
PROACTIVE_SWEEP_INTERVAL_MS=600000

# Aliyun OSS (optional for image uploads)
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=

IMAGE_INVITE_CODE=replace-with-a-random-shared-code
IMAGE_UPSTREAM_BASE_URL=https://apirouter.zhiqiteai.cn/ApiRouterServ/v1
IMAGE_UPSTREAM_API_KEY=replace-with-upstream-key
IMAGE_RATE_LIMIT_PER_MINUTE=3
IMAGE_DAILY_LIMIT=30
IMAGE_MAX_PROMPT_LENGTH=4000
