{
  "name": "pet10",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "server:dev": "npm run dev --workspace server",
    "server:test": "npm run test --workspace server",
    "server:build": "npm run build --workspace server",
    "test": "vitest",
    "test:all": "npm test -- --run && npm test --prefix miniapp && npm run server:test",
    "build:all": "npm run server:build",
    "check:assets": "node scripts/check-assets.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "upload:static": "node scripts/upload-static-to-cos.mjs",
    "verify:quick": "node scripts/verify-quick.mjs",
    "verify:full": "node scripts/verify-full.mjs"
  },
  "devDependencies": {
    "cos-nodejs-sdk-v5": "^3.0.0",
    "miniapp-kit": "git+https://github.com/SuperKingC/miniapp-kit.git#v0.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
